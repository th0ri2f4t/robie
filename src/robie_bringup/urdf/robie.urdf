<?xml version="1.0"?>
<robot name="robie">
  <link name="base_link">
    <visual><origin xyz="0 0 0.15"/><geometry><box size="0.5 0.4 0.15"/></geometry></visual>
    <collision><origin xyz="0 0 0.15"/><geometry><box size="0.5 0.4 0.15"/></geometry></collision>
    <inertial><mass value="10"/><inertia ixx="0.2" iyy="0.3" izz="0.4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="base_scan">
    <visual><geometry><cylinder radius="0.05" length="0.06"/></geometry></visual>
    <inertial><mass value="0.1"/><inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/><child link="base_scan"/><origin xyz="0 0 0.28"/>
  </joint>

  <gazebo>
    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odometry_rate>20</odometry_rate>
      <publish_odometry_tf>true</publish_odometry_tf>
    </plugin>
  </gazebo>

  <gazebo reference="base_scan">
    <sensor name="lidar" type="ray">
      <pose>0 0 0.03 0 0 0</pose>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.12</min><max>10.0</max><resolution>0.02</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="lidar_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_scan</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
